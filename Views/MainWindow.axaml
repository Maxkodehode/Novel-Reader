<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Novel_Reader.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avaloniaPdfViewer="clr-namespace:AvaloniaPdfViewer;assembly=AvaloniaPdfViewer"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Novel_Reader.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Novel_Reader">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    
    <DockPanel>
        <!-- Menu Bar -->
        <!--<Menu Opacity="0" Background="#282828" Height="15" DockPanel.Dock="Top">
            
            <MenuItem Header="File">
                <MenuItem Header="Open New" 
                          Command="{Binding OpenNewFolderCommand}" 
                          CommandParameter="{Binding $parent[Window]}" />
                <Separator/>
                <MenuItem Header="Change save folder"
                          Command="{Binding ChangeSaveDirectoryCommand}"
                          CommandParameter="{Binding $parent[Window]}"/>
            </MenuItem>
            <MenuItem Header="View">
            </MenuItem>
        </Menu>-->
        <Button VerticalAlignment="Top" Command="{Binding TriggerPaneCommand}">
                                -
                            </Button>
        
        <SplitView IsPaneOpen="{Binding Settings.IsPaneOpen}"
                   DisplayMode="CompactInline"
                   CompactPaneLength="1"
                   OpenPaneLength="150"
                   FontSize="10">
            <SplitView.Pane>
                <StackPanel>
                    
                    <ListBox>
                        <ListBoxItem>- Open New</ListBoxItem>
                        <ListBoxItem>- Set New Save Directory</ListBoxItem>
                        <ListBoxItem></ListBoxItem>
                        <ListBoxItem></ListBoxItem>
                        <ListBoxItem></ListBoxItem>
                        <ListBoxItem></ListBoxItem>
                        <ListBoxItem></ListBoxItem>
                        <ListBoxItem></ListBoxItem>
                        
                        
                            
                        
                    </ListBox>
                </StackPanel>

            </SplitView.Pane>
            
        </SplitView>
        
        <!-- Main Content Area -->
         
        <ScrollViewer>
          
        <avaloniaPdfViewer:PdfViewer Source="{Binding Settings.ContentText}"
                                     HorizontalAlignment="Stretch" 
                                     VerticalAlignment="Stretch"/>
            <!--<TextBlock Text="{Binding Settings.ContentText}" 
                       TextWrapping="Wrap"
                       Margin="1"
                       FontSize="{Binding Settings.ReaderFontSize}"
                       FontFamily="{Binding Settings.ReaderFontFamily}"
                       Background="{Binding Settings.BackGroundColor}"
                       Foreground="{Binding Settings.TextColor}">
            </TextBlock>-->
        </ScrollViewer>
    </DockPanel>
</Window>
